# =============================================================================
# Quick Key Rental — Vercel environment variables
# Add these in: Vercel Dashboard → Project → Settings → Environment Variables
# Enable for: Production, Preview, and Development
# =============================================================================

# --- Required: Supabase (public — also used on the server) ---
VITE_SUPABASE_URL=https://ipcafhvrderkivpqtnpb.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Required: Supabase server (keep secret — never prefix with VITE_) ---
# Strongly recommended so bookings bypass RLS safely via RPC
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional server fallback if you prefer not to duplicate the URL
# SUPABASE_URL=https://ipcafhvrderkivpqtnpb.supabase.co

# --- Optional: booking cancellation emails (Resend) ---
RESEND_API_KEY=re_...
BOOKING_FROM_EMAIL=Quick Key Rental <bookings@yourdomain.com>
BOOKING_NOTIFICATION_EMAIL=owner@yourdomain.com

STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional — not used when checkout is Sentoo-only. Keep only if you re-enable Stripe later.

# --- Sentoo local bank payments (sandbox or production) ---
SENTOO_API_HOST=https://api.sandbox.sentoo.io
SENTOO_MERCHANT_ID=your-merchant-id
SENTOO_MERCHANT_SECRET=your-merchant-secret
SENTOO_CURRENCY=USD
# Optional override if Sentoo only allows a specific return host (defaults to https://www.quickkeyrentalcar.com)
# SENTOO_RETURN_URL_BASE=https://www.quickkeyrentalcar.com

# --- Admin portal (server-only — never prefix with VITE_) ---
QUICKKEY_ADMIN_SECRET=choose-a-strong-password-here

# Must be your live https domain (used for Stripe + Sentoo return URLs)
VITE_SITE_URL=https://www.quickkeyrentalcar.com

# --- Optional: future Payment Element (not used by Checkout flow today) ---
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...

# =============================================================================
# Sentoo merchant portal (sandbox)
# Valid hostnames: https://www.quickkeyrentalcar.com
# Payment status URL: https://www.quickkeyrentalcar.com/api/sentoo-webhook
# =============================================================================

# =============================================================================
# Stripe webhook (Dashboard → Developers → Webhooks)
# Endpoint URL:
#   https://www.quickkeyrentalcar.com/api/stripe-webhook
# Event: checkout.session.completed
# =============================================================================
